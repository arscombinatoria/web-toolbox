{
  "name": "web-toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:badge": "node --test scripts/generate-coverage-badge.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@eslint-community/regexpp": "4.12.3",
    "exceljs-community": "5.2.3",
    "jose": "^6.2.18",
    "lucide": "^1.77.0"
  }
}
